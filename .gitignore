# ---------------------------------------------------------------------------
# Bunny.ai - ignored files
#
# Keep credentials, local project artifacts and Python build output out of Git.
# ---------------------------------------------------------------------------

# Secrets, credentials and keys
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
*.secret
*.secrets
id_rsa*
id_ed25519*
id_ecdsa*
credentials*.json
service-account*.json
secrets/
.secrets/

# Local configuration and personal overrides
config.local.*
*.local.toml
*.local.yaml
*.local.yml
*.local.json
local.settings.*
*.private.*

# Runtime state, memory and user data
runtime/
var/
data/
memory/
memories/
*.sqlite
*.sqlite3
*.sqlite3-*
*.sqlite-*
*.db
*.db-*
*.db.*
*.sqlite3.*
*.db-wal
*.db-shm
.bunny.ledger.json
.bunny.ledger.lock
.bunny.dispatch.lock

# Exports, backups and caches
exports/
backups/
cache/
*.bak
*.backup

# Logs, transcripts and captured audio
logs/
*.log
transcripts/
recordings/
audio/
*.wav
*.mp3
*.m4a
*.ogg
*.flac

# Operating system and editor noise
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/

# ---------------------------------------------------------------------------
# Python and uv tooling
# ---------------------------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.uv-cache/
.uv-python/
*.egg-info/
build/
dist/

